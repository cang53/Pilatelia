# E-mail aux clientes (confirmation, annulation, rappel de la veille).
# Sans RESEND_API_KEY + EMAIL_FROM, l'app marche mais n'envoie pas d'e-mail (tracé en logs).
RESEND_API_KEY=re_votre_cle
EMAIL_FROM=Pilatelia <reservations@votre-domaine.fr>

# Coordonnées du studio (affichées côté cliente pour modifier/annuler, et en pied d'e-mail).
STUDIO_NAME=Pilatelia Studio
STUDIO_EMAIL=studio@votre-domaine.fr
STUDIO_PHONE=06 12 34 56 78
STUDIO_ADDRESS=12 rue du Calme, 1000 Bruxelles

# Instagram du studio : @pseudo ou URL. Alimente le bouton "Abonnements" côté cliente.
STUDIO_INSTAGRAM=@pilatelia

